import json, requests, httpx
mc,color,lib = "Chiller", "orange", "requests"
found = []
def check_all(name):
    f = open("sites.json", encoding="utf-8")
    sites = json.load(f)
    result = []
    for site in sites:
        url = sites[site].replace("{}", name)
        try:
            if lib == "requests":
                code = requests.get(url, timeout=3).status_code
            else:
                code = httpx.get(url, timeout=3).status_code
        except:
            code = 0
        if code == 200:
            print("[+]", site, url)
            result.append(site + "  " + url)
        else:
            print("[-]", site)
    return result

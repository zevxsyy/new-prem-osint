def change_color():
    global color
    if color == "orange":color = "purple"
    elif color == "purple":color = "lime"
    elif color == "lime":color = "red"
    elif color == "red":color = "white"
    else:color = "orange"
    for w in all_widgets:
        w.config(fg=color)
    footer.config(fg=color)
    footer_left.config(fg=color)
    footer_right.config(fg=color)
def change_lib():

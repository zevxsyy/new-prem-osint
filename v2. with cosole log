def start():
    global found
    text = entry.get()
    if text == "":
        messagebox.showerror("ашибка", "заполни юз или почту жертвы в настройки!")
        return
    if "@" in text:text = text.split("@")[0]
    hide()
    searching.place(x=150, y=250)
    small.place(x=70, y=300)
    oke.place(x=120, y=400)
    root.update()
    found = check_all(text)
